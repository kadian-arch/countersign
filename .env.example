# Copy this file to .env and fill it in. .env is ignored by git and never leaves your machine.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials, Sandbox tab)
# the REST app belongs to the sandbox business account that plays the shop
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# the shop on the page
# the address you write to the assistant from, a long random text that lets you approve held actions, and the shop's name
OWNER_EMAIL=
OWNER_TOKEN=
SHOP_NAME=

# the shop's mailbox: customers and suppliers write here and the assistant's replies are sent from it.
# use a mailbox made for the shop. for Gmail turn on 2-step verification, then create an app password
# (myaccount.google.com > Security > App passwords). leave both empty to use the page's inbox only
MAIL_USER=
MAIL_PASSWORD=
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_AUTHSERV=mx.google.com
# MAIL_POLL_SECONDS=20

# where this server can be reached, used for the approve links in the emails to the owner
# (http://127.0.0.1:8000 when you run it on your own machine)
# PUBLIC_URL=https://countersign.example.com

# PayPal's webhook for this server, so PayPal reports payments, refunds, disputes and payouts to the shop.
# run scripts/register_webhook.py once the server is on the internet, it prints the id
# PAYPAL_WEBHOOK_ID=

# model providers, tried in order. a provider with no key is skipped.
# the assistant that reads email and the plain-English rule translator both need one
LLM_PROVIDERS=cerebras,groq,gemini
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
# optional model lists per provider, comma separated
# CEREBRAS_MODELS=
# GROQ_MODELS=
# GEMINI_MODELS=
# NVIDIA_MODELS=

# demo seeding only: a card from the sandbox Credit Card Generator (Visa, US)
SANDBOX_CARD_NUMBER=
# YYYY-MM
SANDBOX_CARD_EXPIRY=

# two sandbox personal accounts that play the supplier and the attacker.
# the addresses are shown on the page, so use made-up looking ones created for the demo
# (create them in the sandbox accounts page), not an address of yours
SANDBOX_SUPPLIER_EMAIL=
SANDBOX_ATTACKER_EMAIL=
