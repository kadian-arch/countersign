{
  "info": {
    "name": "Countersign API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Countersign sits between an AI agent and a shop's PayPal account. Start with folder 1, then 2. Folder 3 is a private practice shop where everything is safe to try. Folder 4 needs the owner token. Nothing here needs a PayPal login."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://countersign-l6fh.onrender.com"
    },
    {
      "key": "owner_token",
      "value": ""
    },
    {
      "key": "day_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Look around (no token needed)",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"answers 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok\", () => pm.expect(pm.response.json().ok).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "The shop's state, and remember today's examples",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/state",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "state"
              ]
            },
            "description": "Run this first. It stores the shop's own example order and invoices in collection variables, which the guard requests use. On the shared shop other people's addresses are hidden."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"answers 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json(), c = s.cast, d = c.demo, v = (k, x) => pm.collectionVariables.set(k, x == null ? '' : String(x));",
                  "v('owner_email', c.owner); v('supplier_email', c.supplier); v('contact_email', c.contact);",
                  "v('honest_order', d.honest.order_no); v('honest_email', d.honest.email); v('honest_amount', d.honest.amount);",
                  "v('other_order', d.other.order_no); v('other_amount', d.other.amount);",
                  "v('inv_honest', d.inv_honest.invoice_id); v('inv_honest_amount', d.inv_honest.amount);",
                  "v('inv_near', d.inv_near.invoice_id); v('inv_near_amount', d.inv_near.amount);",
                  "v('inv_big', d.inv_big.invoice_id); v('inv_big_amount', d.inv_big.amount);",
                  "v('lookalike_receiver', c.supplier.replace('o', '0'));   // one character off, as the page's example does",
                  "pm.test(\"the shop gave its examples\", () => pm.expect(pm.collectionVariables.get(\"honest_order\")).to.not.eql(\"\"));"
                ]
              }
            }
          ]
        },
        {
