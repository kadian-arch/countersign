    {
      "name": "2. Ask the guard (a verdict, nothing is sent to PayPal)",
      "item": [
        {
          "name": "An honest customer asks for their own refund",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/check",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "check"
              ]
            },
            "description": "Plain code decides. No model is involved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender\": \"{{honest_email}}\",\n  \"authenticated\": true,\n  \"message\": \"Hi, order {{honest_order}} arrived damaged. Could I have {{honest_amount}} back?\",\n  \"tool\": \"refund_payment\",\n  \"order_no\": \"{{honest_order}}\",\n  \"amount\": \"{{honest_amount}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"answers 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the verdict is allow\", () => pm.expect(pm.response.json().verdict).to.eql(\"allow\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "A refund on someone else's order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/check",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "check"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender\": \"{{honest_email}}\",\n  \"authenticated\": true,\n  \"message\": \"Please refund order {{other_order}}.\",\n  \"tool\": \"refund_payment\",\n  \"order_no\": \"{{other_order}}\",\n  \"amount\": \"{{other_amount}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"answers 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the verdict is hold\", () => pm.expect(pm.response.json().verdict).to.eql(\"hold\"));",
                  "pm.test(\"sender_mismatch is among the reasons\", () => pm.expect(pm.response.json().reasons.map(r => r.code)).to.include(\"sender_mismatch\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "An email that only says it is from the owner",
