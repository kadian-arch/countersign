    {
      "name": "3. Your private practice shop (simulated PayPal, safe to experiment)",
      "item": [
        {
          "name": "Switch to the practice shop",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mode",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mode"
              ]
            },
            "description": "Sets a cookie, which Postman keeps. From now on the requests in this folder act on your own private shop, not the shared one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"practice\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"answers 200\", () => pm.response.to.have.status(200));"
